@page
@model ReliableAcademy.IdentityPages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<section class="rci-login-page">
    <div class="rci-login-showcase">
        <div class="rci-login-showcase-inner">
            <div class="rci-login-brand">
                <span class="rci-login-brand-mark">R<span>.</span></span>
                <span><b>RELIABLE</b><small>COACHING CLASSES</small></span>
            </div>
            <div class="rci-login-message">
                <span class="rci-login-kicker"><i></i> YOUR INSTITUTE. IN GOOD HANDS.</span>
                <h1>Great learning<br /><em>starts with</em><br />great management.</h1>
                <p>One secure place to manage students, classes, attendance, fees and academic progress.</p>
            </div>
            <div class="rci-login-showcase-bottom">
                <div class="rci-login-mini-stat"><span>01</span><b>Admissions & students</b></div>
                <div class="rci-login-mini-stat"><span>02</span><b>Attendance & academics</b></div>
                <div class="rci-login-mini-stat"><span>03</span><b>Fees & reporting</b></div>
                <div class="rci-login-copyright">RELIABLE COACHING CLASSES <span>·</span> ROSHAN GATE, AURANGABAD</div>
            </div>
        </div>
        <div class="rci-login-decoration rci-login-decoration-one"></div>
        <div class="rci-login-decoration rci-login-decoration-two"></div>
    </div>
    <div class="rci-login-form-side">
        <div class="rci-login-mobile-brand">
            <span class="rci-login-brand-mark">R<span>.</span></span>
            <span><b>RELIABLE</b><small>COACHING CLASSES</small></span>
        </div>
        <div class="rci-login-form-wrap">
            <div class="rci-login-form-heading">
                <span class="rci-login-overline">SECURE PORTAL ACCESS</span>
                <h2>Welcome back<span>.</span></h2>
                <p>Sign in with the account provided by your institute administrator.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="rci-login-error" role="alert"><span>!</span><div><b>Unable to sign in</b><small>@Model.ErrorMessage</small></div></div>
            }
            <form method="post" class="rci-login-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="rci-login-validation"></div>
                <div class="rci-login-field">
                    <label asp-for="Input.Email">Email address</label>
                    <div class="rci-login-input-wrap"><span class="rci-login-input-icon">✉</span><input asp-for="Input.Email" type="email" autocomplete="username" placeholder="you@reliableclasses.com" autofocus /><span asp-validation-for="Input.Email" class="rci-login-field-error"></span></div>
                </div>
                <div class="rci-login-field">
                    <div class="rci-login-label-row"><label asp-for="Input.Password">Password</label></div>
                    <div class="rci-login-input-wrap"><span class="rci-login-input-icon">⌑</span><input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Enter your password" id="rciPassword" /><button type="button" class="rci-password-toggle" aria-label="Show password" aria-pressed="false" data-password-toggle="rciPassword">Show</button></div>
                    <span asp-validation-for="Input.Password" class="rci-login-field-error"></span>
                </div>
                <label class="rci-login-remember"><input asp-for="Input.RememberMe" /><span>Keep me signed in on this device</span></label>
                <button type="submit" class="rci-login-submit"><span>Sign in to workspace</span><i>↗</i></button>
            </form>
            <div class="rci-login-security"><span>♢</span><p><b>Your account is protected</b><small>Secure sign-in with institute-managed access. Never share your password.</small></p></div>
            <div class="rci-login-back"><a asp-area="" asp-controller="Home" asp-action="Index">← Back to institute website</a></div>
        </div>
        <div class="rci-login-footer">© @DateTime.Now.Year Reliable Coaching Classes <span>·</span> Built for focused learning</div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = document.getElementById(button.dataset.passwordToggle);
                var reveal = input.type === 'password';
                input.type = reveal ? 'text' : 'password';
                button.textContent = reveal ? 'Hide' : 'Show';
                button.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
                button.setAttribute('aria-pressed', reveal ? 'true' : 'false');
            });
        });
    </script>
}