@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Exam results";
    var student = Model.Student;
}
<div class="ra-page-heading"><div><div class="ra-eyebrow">STUDENT PORTAL <span>•</span> MY LEARNING</div><h1>Exam results</h1><p>All your exam marks and subject progress.</p></div><a class="ra-secondary-button" asp-action="Index">← Overview</a></div>
<div class="ra-student-section-page">
    <section class="ra-panel" id="performance">
        <div class="ra-panel-heading"><div><span>LEARNING PROGRESS</span><h3>Subject performance</h3></div></div>
        @if (Model.RecentResults.Count == 0) {
            <div class="ra-empty"><span>◎</span><b>No performance data yet</b><p>Subject averages will appear when exam results are recorded.</p></div>
        } else {
            <div class="ra-student-subject-progress">
            @foreach (var subject in Model.RecentResults.GroupBy(x => new { x.Exam.SubjectId, x.Exam.Subject.Name }).OrderBy(x => x.Key.Name)) {
                var percent = subject.Where(x => x.Exam.MaximumMarks > 0).Select(x => Math.Clamp((double)(x.MarksObtained / x.Exam.MaximumMarks * 100m), 0d, 100d)).DefaultIfEmpty(0).Average();
                <div class="ra-student-progress-item">
                    <div class="ra-student-progress-caption"><b>@subject.Key.Name</b><span>@percent.ToString("0.#")% average · @subject.Count() exam(s)</span></div>
                    <div class="ra-student-progress-track" role="progressbar" aria-label="@subject.Key.Name performance" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"><span style="width:@percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
            }
            </div>
            <small class="ra-panel-note">Subject averages are calculated from recorded exam marks and maximum marks, with equal weight per exam.</small>
        }
    </section>

    <section class="ra-panel" id="results">
        <div class="ra-panel-heading"><div><span>ACADEMIC PERFORMANCE</span><h3>Exam result history</h3></div><span class="ra-panel-note">@Model.AllExamCount results</span></div>
        @if (Model.RecentResults.Count == 0) {
            <div class="ra-empty"><span>◎</span><b>No results entered yet</b><p>Recorded examination marks will appear here.</p></div>
        } else {
            <div class="table-responsive"><table class="ra-data-table"><thead><tr><th>EXAM</th><th>SUBJECT</th><th>DATE</th><th>MARKS</th><th>RESULT</th></tr></thead><tbody>
            @foreach (var result in Model.RecentResults) {
                <tr><td>@result.Exam.Name</td><td>@result.Exam.Subject.Name</td><td>@result.Exam.ExamDate.ToString("dd MMM yyyy")</td>
                <td><b>@result.MarksObtained.ToString("0.##") / @result.Exam.MaximumMarks.ToString("0.##")</b></td>
                <td>@(result.MarksObtained >= result.Exam.PassingMarks ? "Pass" : "Below pass mark")</td></tr>
            }
            </tbody></table></div>
        }
    </section>

</div>
<style>
.ra-student-history-filter{display:flex;align-items:center;flex-wrap:wrap;gap:.65rem;margin:1rem 0}
.ra-student-history-filter input{padding:.6rem;border:1px solid #cad5cb;border-radius:.65rem;background:#fff;max-width:180px}
.ra-student-history-filter label{font-weight:650}
.ra-panel-note{display:block;margin-top:.75rem}
.ra-data-table td{vertical-align:middle}
.ra-student-fee-row small{display:block}
.ra-student-subject-progress{display:grid;gap:1.1rem;margin-top:1rem}.ra-student-progress-caption{display:flex;justify-content:space-between;gap:.8rem;flex-wrap:wrap;margin-bottom:.4rem}.ra-student-progress-caption span{font-size:.875rem;opacity:.75}.ra-student-progress-track{height:10px;background:#e6ece8;border-radius:20px;overflow:hidden}.ra-student-progress-track>span{display:block;height:100%;border-radius:inherit;background:#5b846b}</style>
