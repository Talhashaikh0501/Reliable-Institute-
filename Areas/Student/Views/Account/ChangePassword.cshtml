@model StudentPasswordViewModel
@{
    ViewData["Title"] = "Change your password";
}
<div class="ra-page-heading"><div><div class="ra-eyebrow">ACCOUNT SECURITY <span>•</span> FIRST SIGN-IN</div><h1>Set your password</h1><p>For your security, replace the temporary password provided by the institute before opening your student dashboard.</p></div></div>
<section class="ra-panel ra-student-password-panel">
    <div class="ra-student-password-note"><b>One-time setup</b><p>Your temporary password will stop working after you set a new password. Choose a password you do not share with anyone.</p></div>
    <form asp-action="ChangePassword" method="post" class="ra-student-password-form">
        <div asp-validation-summary="ModelOnly" class="ra-validation-summary"></div>
        <div class="ra-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
        <div class="ra-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span><small>At least 8 characters, including uppercase, lowercase and a number.</small></div>
        <div class="ra-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <button type="submit" class="ra-primary-button">Save new password <span>→</span></button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
