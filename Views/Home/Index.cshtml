@model IReadOnlyList<ReliableAcademy.Models.Topper>
@{
    ViewData["Title"] = "Reliable Coaching Classes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="rci-home rci-next">
    <section class="rci-next-hero" aria-labelledby="rci-next-title">
        <div class="rci-next-hero-inner">
            <div class="rci-next-hero-copy">
                <div class="rci-next-eyebrow"><span class="rci-next-eyebrow-mark"></span> RELIABLE COACHING CLASSES <i>·</i> ROSHAN GATE, AURANGABAD</div>
                <div class="rci-next-overline">A STRONG START. A STEADIER JOURNEY.</div>
                <h1 id="rci-next-title">Strong basics.<br /><em>Stronger futures.</em></h1>
                <p class="rci-next-hero-lead">Thoughtful, board-focused academic support for students from Standard 8th to 12th — built around clear concepts, purposeful practice and steady progress.</p>
                <div class="rci-next-hero-actions">
                    <a class="rci-next-button rci-next-button-gold" href="#programmes">Explore our classes <span aria-hidden="true">↘</span></a>
                    <a class="rci-next-text-link" href="#visit">Plan an institute visit <span aria-hidden="true">↗</span></a>
                </div>
                <div class="rci-next-hero-facts">
                    <span><b>2014</b><small>ESTABLISHED</small></span>
                    <i></i>
                    <span><b>VIII–XII</b><small>STANDARDS</small></span>
                    <i></i>
                    <span><b>AURANGABAD</b><small>ROSHAN GATE</small></span>
                </div>
            </div>
            <div class="rci-next-hero-media">
                <div class="rci-next-hero-image">
                    <img src="https://images.pexels.com/photos/448877/pexels-photo-448877.jpeg?cs=srgb&amp;dl=pexels-akelaphotography-448877.jpg&amp;fm=jpg" alt="Classroom in Dharwad, India, with girls wearing hijab studying in front and boys seated behind them" fetchpriority="high" />
                    <div class="rci-next-photo-shade"></div>
                    <div class="rci-next-image-topline"><span>LEARNING WITH PURPOSE</span><span>01 / 03</span></div>
                    <div class="rci-next-image-caption">
                        <span>A PLACE TO BUILD CONFIDENCE</span>
                        <strong>Every lesson<br />moves you forward.</strong>
                    </div>
                    <div class="rci-next-image-foot"><span class="rci-next-image-dot"></span> Illustrative classroom photography</div>
                </div>
                <div class="rci-next-hero-seal"><span>R.</span><small>RELIABLE<br />SINCE 2014</small></div>
            </div>
        </div>
        <div class="rci-next-hero-bottom"><span>LEARNING STARTS WITH A STRONG FOUNDATION</span><a href="#learning">DISCOVER OUR APPROACH <b>↓</b></a></div>
    </section>

    <section class="rci-next-proof" aria-label="Institute overview">
        <div class="rci-next-proof-inner">
            <div class="rci-next-proof-intro"><span>THE RELIABLE DIFFERENCE</span><b>Focused on what<br />matters in learning.</b></div>
            <div class="rci-next-proof-item"><span class="rci-next-proof-number">01</span><b>Since 2014</b><small>A consistent local presence</small></div>
            <div class="rci-next-proof-item"><span class="rci-next-proof-number">02</span><b>Standards 8th–12th</b><small>Support across key school years</small></div>
            <div class="rci-next-proof-item"><span class="rci-next-proof-number">03</span><b>Board-focused</b><small>Academic learning with direction</small></div>
        </div>
    </section>

    <section class="rci-next-section rci-next-intro" id="learning">
        <div class="rci-next-section-kicker"><span>01</span> OUR BELIEF ABOUT LEARNING</div>
        <div class="rci-next-intro-grid">
            <div class="rci-next-intro-copy">
                <h2>Understanding first.<br /><em>Progress that follows.</em></h2>
                <p class="rci-next-large-copy">Learning should do more than help a student remember an answer. It should help them understand the idea, ask better questions and approach the next challenge with confidence.</p>
                <p>At Reliable Coaching Classes, our focus is school academics for Standards 8th to 12th. We believe strong fundamentals and a thoughtful approach to preparation make a meaningful difference at every stage.</p>
                <a class="rci-next-underlined-link" href="#method">The way we approach learning <span>↗</span></a>
            </div>
            <div class="rci-next-intro-visual">
                <div class="rci-next-intro-photo">
                    <img src="https://images.pexels.com/photos/18012463/pexels-photo-18012463.jpeg?cs=srgb&amp;dl=pexels-swastikarora-18012463.jpg&amp;fm=jpg" alt="Two Indian schoolboys in uniform studying together at a classroom desk" loading="lazy" />
                    <span class="rci-next-photo-tag">FOCUS · CURIOSITY · PROGRESS</span>
                </div>
                <div class="rci-next-intro-note"><span>OUR GUIDING THOUGHT</span><b>Make the concept clear.<br />Make the effort count.</b><i>RELIABLE COACHING CLASSES</i></div>
            </div>
        </div>
    </section>

    <section class="rci-next-programmes" id="programmes">
        <div class="rci-next-section rci-next-programmes-inner">
            <div class="rci-next-section-kicker rci-next-kicker-light"><span>02</span> ACADEMIC PROGRAMMES</div>
            <div class="rci-next-programmes-heading">
                <div><h2>Guidance for every<br /><em>important year.</em></h2></div>
                <p>Each class brings a different responsibility. Our academic focus is shaped around the stage a student is preparing for.</p>
            </div>
            <div class="rci-next-programme-grid">
                <article class="rci-next-programme-card">
                    <div class="rci-next-programme-top"><span>FOUNDATION YEARS</span><b>01</b></div>
                    <div class="rci-next-programme-grade">08 <i>—</i> 09</div>
                    <h3>Build the basics<br />that last.</h3>
                    <p>Strengthen subject fundamentals, develop a regular study rhythm and create a more confident base for higher classes.</p>
                    <div class="rci-next-programme-tags"><span>CONCEPT CLARITY</span><span>STUDY HABITS</span></div>
                    <a href="#visit" aria-label="Ask about Standards 8th and 9th">Ask about these classes <span>↗</span></a>
                </article>
                <article class="rci-next-programme-card rci-next-programme-card-featured">
                    <div class="rci-next-programme-top"><span>BOARD YEARS</span><b>02</b></div>
                    <div class="rci-next-programme-grade">10 <i>—</i> 12</div>
                    <h3>Prepare with<br />clarity and purpose.</h3>
                    <p>Focused academic support for Standards 10th, 11th and 12th, with the demands of board examinations in view.</p>
                    <div class="rci-next-programme-tags"><span>BOARD FOCUS</span><span>EXAM PREPARATION</span></div>
                    <a href="#visit" aria-label="Ask about Standards 10th to 12th">Ask about these classes <span>↗</span></a>
                </article>
            </div>
            <div class="rci-next-programmes-foot"><span>ACADEMIC SUPPORT FOR SCHOOL STUDENTS</span><span>STANDARD VIII THROUGH XII <b>·</b> AURANGABAD</span></div>
        </div>
    </section>

    <section class="rci-next-section rci-next-method" id="method">
        <div class="rci-next-section-kicker"><span>03</span> THE RELIABLE APPROACH</div>
        <div class="rci-next-method-grid">
            <div class="rci-next-method-photo">
                <img src="https://images.pexels.com/photos/448877/pexels-photo-448877.jpeg?cs=srgb&amp;dl=pexels-akelaphotography-448877.jpg&amp;fm=jpg" alt="Classroom in Dharwad, India, with students in hijab studying and boys visible behind them" loading="lazy" />
                <div class="rci-next-method-photo-caption"><span>LEARNING IS A JOURNEY</span><b>Small steps.<br />Meaningful progress.</b></div>
            </div>
            <div class="rci-next-method-copy">
                <h2>A steady way to<br /><em>make learning stick.</em></h2>
                <p class="rci-next-large-copy">Good academic progress is built through consistent effort, not shortcuts.</p>
                <div class="rci-next-method-steps">
                    <article><span>01</span><div><h3>Understand</h3><p>Give every concept the time and explanation it deserves.</p></div></article>
                    <article><span>02</span><div><h3>Practise</h3><p>Turn understanding into confidence through purposeful practice.</p></div></article>
                    <article><span>03</span><div><h3>Review</h3><p>Revisit important ideas and keep the next academic goal in sight.</p></div></article>
                </div>
            </div>
        </div>
    </section>

    @if (Model.Count > 0)
    {
    <section class="rci-next-results" id="results">
        <div class="rci-next-results-inner">
            <div class="rci-next-results-copy">
                <div class="rci-next-section-kicker rci-next-kicker-light"><span>04</span> A CELEBRATION OF EFFORT</div>
                <h2>Every achievement<br />begins with <em>effort.</em></h2>
                <p>We are proud to recognise the dedication, discipline and hard work of our students. Meet some of our achievers.</p>
                <div class="rci-next-demo-notice"><span>STUDENT ACHIEVEMENTS</span><b>Celebrating effort and progress.</b><small>Results are published by the institute with permission from the student and their parent or guardian.</small></div>
            </div>
            <div class="rci-next-topper-wall" aria-label="Reliable Coaching Classes student achievers">
                <div class="rci-next-topper-wall-head"><span>THE TOPPER WALL</span><span>RELIABLE ACHIEVERS</span></div>
                <div class="rci-next-topper-grid">
                    @foreach (var topper in Model)
                    {
                        <article class="rci-next-topper-card">
                            <div class="rci-next-topper-photo"><img src="@Url.Content("~/" + topper.PhotoPath.TrimStart('/'))" alt="Photograph of @topper.StudentName" loading="lazy" /></div>
                            <span class="rci-next-topper-rank">@((int)topper.Standard)TH STANDARD <i>· @topper.AcademicYear</i></span>
                            <strong>@topper.Percentage.ToString("0.0")<small>%</small></strong>
                            <b>@topper.StudentName</b>
                            <span>@topper.ExamName · @topper.MarksObtained.ToString("0.##") / @topper.MaximumMarks.ToString("0.##") MARKS</span>
                            @if (!string.IsNullOrWhiteSpace(topper.AchievementNote))
                            {
                                <div class="rci-next-topper-achievement"><span aria-hidden="true">★</span><b>@topper.AchievementNote</b></div>
                            }
                        </article>
                    }
                </div>
                <div class="rci-next-topper-foot"><span>RECOGNISING DEDICATION</span><span>RELIABLE COACHING CLASSES</span></div>
            </div>
        </div>
    </section>
    }

    <section class="rci-next-section rci-next-gallery">
        <div class="rci-next-gallery-heading">
            <div><div class="rci-next-section-kicker"><span>05</span> THE SPIRIT OF LEARNING</div><h2>Curiosity in every<br /><em>classroom.</em></h2></div>
            <p>A good learning environment makes room for concentration, questions and steady effort.</p>
        </div>
        <div class="rci-next-gallery-grid">
            <figure class="rci-next-gallery-large">
                <img src="https://images.pexels.com/photos/18012463/pexels-photo-18012463.jpeg?cs=srgb&amp;dl=pexels-swastikarora-18012463.jpg&amp;fm=jpg" alt="Two Indian schoolboys in uniform listening attentively in their classroom" loading="lazy" />
                <figcaption><span>01 / FOCUS</span><b>Learning together, with purpose.</b></figcaption>
            </figure>
            <figure class="rci-next-gallery-small">
                <img src="https://images.pexels.com/photos/448877/pexels-photo-448877.jpeg?cs=srgb&amp;dl=pexels-akelaphotography-448877.jpg&amp;fm=jpg" alt="Girls wearing traditional hijab studying in a classroom in Dharwad, India, with boys visible in the background" loading="lazy" />
                <figcaption><span>02 / CONSISTENCY</span><b>Progress built one step at a time.</b></figcaption>
            </figure>
        </div>
        <p class="rci-next-stock-note">The photographs on this page are illustrative stock images, not actual Reliable Coaching Classes students or classrooms. They are used for this design preview and should be replaced with institute photographs before final publication.</p>
    </section>

    <section class="rci-next-visit" id="visit">
        <div class="rci-next-visit-inner">
            <div class="rci-next-visit-copy">
                <div class="rci-next-section-kicker rci-next-kicker-light"><span>06</span> FIND YOUR WAY TO RELIABLE</div>
                <h2>Come see where<br /><em>learning begins.</em></h2>
                <p>We welcome parents and students to visit Reliable Coaching Classes and learn more about the academic support offered for Standards 8th to 12th.</p>
                <a class="rci-next-button rci-next-button-gold" href="https://www.google.com/maps/search/?api=1&amp;query=Plot+No.+5,+near+Fatema+Girls+High+School,+Nagsen+Colony,+Jinsi+Road,+Roshan+Gate,+Aurangabad,+Maharashtra+431003" target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
            </div>
            <div class="rci-next-address-card">
                <div class="rci-next-address-top"><span class="rci-next-address-mark">R.</span><span>VISIT THE INSTITUTE <i>·</i> AURANGABAD</span></div>
                <div class="rci-next-address-label">RELIABLE COACHING CLASSES</div>
                <address>Plot No. 5, Near Fatema Girls High School,<br />Nagsen Colony, Jinsi Road, Roshan Gate,<br />Aurangabad, Maharashtra – 431003</address>
                <div class="rci-next-address-divider"></div>
                <div class="rci-next-address-links"><a href="https://www.google.com/maps/search/?api=1&amp;query=Plot+No.+5,+near+Fatema+Girls+High+School,+Nagsen+Colony,+Jinsi+Road,+Roshan+Gate,+Aurangabad,+Maharashtra+431003" target="_blank" rel="noopener noreferrer">Open in Google Maps <span>↗</span></a><a href="https://www.justdial.com/Aurangabad-Maharashtra/Reliable-Coaching-Classes-Nagsen-Colony-Aurangabad-HO/9999PX240-X240-150524001926-Z4N8_BZDET" target="_blank" rel="noopener noreferrer">View institute profile <span>↗</span></a></div>
                <div class="rci-next-address-coordinate"><span></span> ROSHAN GATE · AURANGABAD, MH</div>
            </div>
        </div>
    </section>

    <footer class="rci-next-footer">
        <div class="rci-next-footer-main">
            <a class="rci-next-footer-brand" asp-controller="Home" asp-action="Index"><span>R<span>.</span></span><b>RELIABLE<small>COACHING CLASSES</small></b></a>
            <p>Strong foundations. Clear understanding.<br />A steadier path towards what comes next.</p>
            <a href="#visit">Plan a visit <span>↗</span></a>
        </div>
        <div class="rci-next-footer-bottom"><span>© @DateTime.Now.Year Reliable Coaching Classes · Roshan Gate, Aurangabad</span><span>STANDARDS VIII–XII · EST. 2014</span></div>
        <div class="rci-next-credits">Preview photography by <a href="https://www.pexels.com/photo/shallow-focus-photography-of-girl-448877/" target="_blank" rel="noopener noreferrer">Akela Photography</a> and <a href="https://www.pexels.com/photo/two-boys-are-sitting-at-a-desk-with-books-18012463/" target="_blank" rel="noopener noreferrer">Swastik Arora</a> via <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer">Pexels</a>. The photographs are illustrative stock images, not actual Reliable Coaching Classes students or classrooms.</div>
    </footer>
</div>
