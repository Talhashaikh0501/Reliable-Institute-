@model TeacherExamResultViewModel
@{
    ViewData["Title"] = "Enter exam results";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ra-page-heading"><div><div class="ra-eyebrow">ASSESSMENTS <span>•</span> MARKS ENTRY</div><h1>@Model.Exam.Name</h1><p>@Model.Exam.Subject.Name · @Model.BatchName · @Model.Exam.ExamDate.ToString("dd MMM yyyy") · Maximum @Model.Exam.MaximumMarks.ToString("0.##") marks</p></div><a class="ra-secondary-button" asp-action="Exams" asp-route-batchId="@Model.BatchId">← Back to exams</a></div>
@if (TempData["Success"] is string success) { <div class="ra-alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="ra-alert-error" role="alert">@error</div> }
<section class="ra-panel ra-table-panel">
    <div class="ra-panel-heading"><div><span>ASSIGNED BATCH ONLY</span><h3>Student marks</h3></div><span class="ra-panel-note">@Model.Students.Count student(s)</span></div>
    @if (Model.Students.Count == 0) { <div class="ra-empty"><span>♙</span><b>No active students in this batch</b><p>There are no student records available for marks entry.</p></div> }
    else {
        <div class="table-responsive"><table class="ra-data-table">
            <thead><tr><th>STUDENT</th><th>ADMISSION NO.</th><th>MARKS / @Model.Exam.MaximumMarks.ToString("0.##")</th><th>REMARKS</th><th>STATUS</th><th></th></tr></thead>
            <tbody>@foreach (var student in Model.Students) {
                var formId = $"result-form-{student.StudentId}";
                <tr>
                    <td>
                        <form id="@formId" asp-action="RecordResult" method="post"></form>
                        <input form="@formId" type="hidden" name="examId" value="@Model.Exam.Id" />
                        <input form="@formId" type="hidden" name="batchId" value="@Model.BatchId" />
                        <input form="@formId" type="hidden" name="studentId" value="@student.StudentId" />
                        <b class="ra-student-name">@student.FullName</b>
                    </td>
                    <td><span class="ra-mono">@student.AdmissionNumber</span></td>
                    <td><input form="@formId" class="ra-teacher-mark-input" type="number" name="marksObtained" min="0" max="@Model.Exam.MaximumMarks" step="0.01" value="@student.MarksObtained?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required aria-label="Marks for @student.FullName" /></td>
                    <td><input form="@formId" class="ra-teacher-remarks" type="text" name="remarks" maxlength="500" value="@student.Remarks" placeholder="Optional remark" aria-label="Remarks for @student.FullName" /></td>
                    <td>@if (student.MarksObtained.HasValue) { <span class="ra-status-pill @(student.IsPassing ? "is-active" : "is-inactive")">@(student.IsPassing ? "Pass" : "Below pass mark")</span> } else { <span class="ra-panel-note">Not entered</span> }</td>
                    <td><button form="@formId" class="ra-row-action ra-link-button" type="submit">Save result</button></td>
                </tr>
            }</tbody>
        </table></div>
    }
</section>
