@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    var destinationArea = User.IsInRole("Teacher") ? "Teacher" : "Admin";
}
@if (SignInManager.IsSignedIn(User))
{
    <div class="rci-auth-actions">
        <a class="rci-workspace-action" asp-area="@destinationArea" asp-controller="Dashboard" asp-action="Index">
            <span class="rci-workspace-action-icon" aria-hidden="true">▦</span>
            <span>Workspace</span>
            <span class="rci-workspace-action-arrow" aria-hidden="true">↗</span>
        </a>
        <form class="rci-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="rci-logout-action">
                <span aria-hidden="true">⇥</span>
                <span>Sign out</span>
            </button>
        </form>
    </div>
}
else
{
    <a class="rci-staff-login-action" asp-area="Identity" asp-page="/Account/Login">Staff sign in <span aria-hidden="true">↗</span></a>
}
