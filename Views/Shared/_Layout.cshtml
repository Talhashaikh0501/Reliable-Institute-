@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var isWorkspaceArea = currentArea == "Admin" || currentArea == "Teacher";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string controller, string? action = null) => currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) && (action == null || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)) ? " active" : "";
    var workspaceArea = User.IsInRole("Teacher") ? "Teacher" : "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="theme-color" content="#111d32" />
<meta name="description" content="Reliable Coaching Classes — focused academics and thoughtful institute management in Roshan Gate, Aurangabad." />
<title>@ViewData["Title"] · Reliable Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/ReliableAcademy.styles.css" asp-append-version="true" />
</head>
<body class="@(isWorkspaceArea ? "ra-app-body" : "ra-public-body")">
@if (isWorkspaceArea)
{
<div class="ra-sidebar-backdrop" data-sidebar-close></div>
<aside class="ra-sidebar" id="ra-sidebar" aria-label="Workspace navigation">
<div class="ra-sidebar-top"><a class="ra-brand" asp-area="@workspaceArea" asp-controller="Dashboard" asp-action="Index"><span class="ra-brand-mark">R<span>.</span></span><span><b>RELIABLE</b><small>ACADEMY · WORKSPACE</small></span></a><button class="ra-sidebar-close" type="button" aria-label="Close navigation" data-sidebar-close>×</button></div>
<div class="ra-workspace-switch"><span class="ra-workspace-switch-dot"></span><span><b>@(currentArea == "Admin" ? "Administrator" : "Teacher") workspace</b><small>Reliable Coaching Classes</small></span></div>
<div class="ra-nav-label">YOUR WORKSPACE</div>
<a class="ra-nav-link@Active("Dashboard")" aria-current="@(currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) ? "page" : null)" asp-area="@workspaceArea" asp-controller="Dashboard" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg></span><span>@(User.IsInRole("Teacher") ? "Teaching desk" : "Overview")</span></a>
<div class="ra-nav-label ra-nav-label-spaced">INSTITUTE</div>
<a class="ra-nav-link@Active("Students")" asp-area="Admin" asp-controller="Students" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21v-2a7 7 0 0 1 14 0v2zM16 4a4 4 0 0 1 0 8m2 3a6 6 0 0 1 4 6"/></svg></span><span>Students</span></a>
<a class="ra-nav-link@Active("Batches")" asp-area="Admin" asp-controller="Batches" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg></span><span>Classes &amp; batches</span></a>
<a class="ra-nav-link@Active("Attendance")" asp-area="Admin" asp-controller="Attendance" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/><path d="M21 12a9 9 0 1 1-5.2-8.2"/></svg></span><span>Attendance</span></a>
<a class="ra-nav-link@Active("Academics", "Subjects")" asp-area="Admin" asp-controller="Academics" asp-action="Subjects"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 4H6l8 8-8 8h12"/></svg></span><span>Subjects</span></a>
<a class="ra-nav-link@Active("Academics", "Exams")" asp-area="Admin" asp-controller="Academics" asp-action="Exams"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span>Exams &amp; results</span></a>
<a class="ra-nav-link@Active("Academics", "Announcements")" asp-area="Admin" asp-controller="Academics" asp-action="Announcements"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2m0-14.2L4.9 19.1"/></svg></span><span>Announcements</span></a>
<a class="ra-nav-link@Active("Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 15l4-4 3 3 6-7"/></svg></span><span>Reports &amp; insights</span></a>
@if (User.IsInRole("Admin")) {
<div class="ra-nav-label ra-nav-label-spaced">ADMINISTRATION</div>
<a class="ra-nav-link@Active("Fees")" asp-area="Admin" asp-controller="Fees" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14M5 8h14M5 4c7 0 9 2 9 5s-2 5-9 5l9 6"/></svg></span><span>Fees &amp; payments</span></a>
<a class="ra-nav-link@Active("Staff")" asp-area="Admin" asp-controller="Staff" asp-action="Index"><span class="ra-nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="6" r="3"/><path d="M6 20a6 6 0 0 1 12 0zM8 14h8"/></svg></span><span>Teachers &amp; staff</span></a>
}
<div class="ra-sidebar-bottom"><div class="ra-sidebar-help"><span>✦</span><b>Built around your institute.</b><small>Less admin. More meaningful progress.</small></div>
<div class="ra-user"><span class="ra-avatar">@((User.Identity?.Name ?? "A").Substring(0, 1).ToUpperInvariant())</span><span><b>@User.Identity?.Name</b><small>@(currentArea == "Admin" ? "Administrator" : "Teacher") · Signed in</small></span><partial name="_LoginPartial" /></div></div>
</aside>
<div class="ra-main-shell"><header class="ra-topbar"><div class="ra-topbar-leading"><button class="ra-topbar-menu" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="ra-sidebar"><span aria-hidden="true">☰</span></button><span class="ra-breadcrumb"><span>Workspace</span><b>/</b> @ViewData["Title"]</span></div><div class="ra-topbar-right"><span class="ra-secure-label"><span></span> PRIVATE WORKSPACE</span><span class="ra-topbar-divider"></span><span class="ra-topbar-user">@User.Identity?.Name</span></div></header><main class="ra-main-content">@RenderBody()</main></div>
}
else
{
<header class="ra-public-header">
<a class="ra-public-brand" asp-controller="Home" asp-action="Index"><span class="ra-brand-mark">R<span>.</span></span><span><b>RELIABLE</b><small>COACHING CLASSES</small></span></a>
<button class="ra-public-menu-toggle" type="button" aria-label="Open website navigation" aria-expanded="false" aria-controls="ra-public-nav">☰</button><nav class="ra-public-nav" id="ra-public-nav" aria-label="Main navigation"><a href="/#approach">Our approach</a><a href="/#programmes">Academics</a><a href="/#visit">Find us</a></nav>
<div class="ra-public-location">ROSHAN GATE <span>·</span> AURANGABAD</div>
@if (User.Identity?.IsAuthenticated == true) { <partial name="_LoginPartial" /> }
else {
<details class="rci-signin-menu"><summary>Workspace sign in <span aria-hidden="true">↗</span></summary><div class="rci-signin-options">
<a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Admin/Dashboard"><span class="rci-signin-option-icon">A</span><span><b>Admin sign in</b><small>Institute management</small></span><i>↗</i></a>
<a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Teacher/Dashboard"><span class="rci-signin-option-icon">T</span><span><b>Teacher sign in</b><small>Teaching workspace</small></span><i>↗</i></a>
</div></details>
}
</header><main>@RenderBody()</main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>