@model IReadOnlyList<ReliableAcademy.Models.Student>
@{
    var exam = (ReliableAcademy.Models.Exam)ViewBag.Exam;
    var results = (Dictionary<int, ReliableAcademy.Models.ExamResult>)ViewBag.Results;
    ViewData["Title"] = "Exam results";
}
<div class="ra-page-heading"><div><div class="ra-eyebrow">ASSESSMENT CENTRE <span>•</span> RESULTS</div><h1>@exam.Name</h1><p>@exam.Subject.Name · @((int)exam.Subject.Standard)th standard · @exam.ExamDate.ToString("dd MMM yyyy") · Maximum @exam.MaximumMarks marks</p></div><a class="ra-secondary-button" asp-action="Exams">← Back to exams</a></div>
@if (TempData["Success"] is string success) { <div class="ra-alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="ra-alert-error">@error</div> }
<section class="ra-panel ra-table-panel"><div class="ra-panel-heading"><div><span>STUDENT PERFORMANCE</span><h3>@Model.Count eligible students</h3></div></div><div class="table-responsive"><table class="ra-data-table">
<thead><tr><th>STUDENT</th><th>ADMISSION NO.</th><th>MARKS / @exam.MaximumMarks</th><th>REMARKS</th><th></th></tr></thead><tbody>
@foreach (var student in Model)
{
    var existing = results.TryGetValue(student.Id, out var saved) ? saved : null;
    <tr><td><b class="ra-student-name">@student.FullName</b></td><td class="ra-mono">@student.AdmissionNumber</td><td colspan="3"><form asp-action="RecordResult" method="post" class="ra-filter-form">
    <input type="hidden" name="examId" value="@exam.Id" /><input type="hidden" name="studentId" value="@student.Id" />
    <div class="ra-filter-field"><label class="visually-hidden">Marks obtained</label><input class="form-control form-control-sm" style="width:110px" type="number" name="marksObtained" min="0" max="@exam.MaximumMarks" step="0.01" value="@(existing?.MarksObtained.ToString("0.##") ?? "")" required /></div>
    <div class="ra-search-field"><label class="visually-hidden">Remarks</label><input name="remarks" maxlength="500" value="@existing?.Remarks" placeholder="Optional remarks" /></div>
    <button class="ra-secondary-button" type="submit">@(existing is null ? "Save" : "Update")</button>
    @if (existing is not null) { <span class="ra-status-pill @(existing.MarksObtained >= exam.PassingMarks ? "is-active" : "is-pending")">@(existing.MarksObtained >= exam.PassingMarks ? "Passed" : "Needs support")</span> }
    </form></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5" class="text-center p-4">No active students are assigned to this exam.</td></tr> }
</tbody></table></div></section>
