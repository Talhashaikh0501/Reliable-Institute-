@model IReadOnlyList<ReliableAcademy.Models.Subject>
@{ Layout = "/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Subjects"; var search=ViewBag.Search as string; var standard=ViewBag.Standard as ReliableAcademy.Models.StudentStandard?; var includeInactive=(bool)(ViewBag.IncludeInactive??false); }
<div class="ra-saas-page"><div class="ra-saas-breadcrumb">ACADEMICS <span>/</span> CURRICULUM</div><div class="ra-saas-page-head"><div><div class="ra-saas-kicker">CURRICULUM MANAGEMENT</div><h1>Subjects <span class="ra-count-chip">@Model.Count total</span></h1><p>Organize the subjects taught across standards 8th through 12th.</p></div>@if(User.IsInRole("Admin")){<a class="ra-saas-primary" href="#add-subject">＋ Add subject</a>}</div>
@if(TempData["Success"] is string success){<div class="ra-alert-success">@success</div>} @if(TempData["Error"] is string error){<div class="ra-alert-error">@error</div>}
<section class="ra-saas-panel"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">FIND A SUBJECT</span><h2>Subject directory</h2></div><span class="ra-saas-panel-caption">Search and filter curriculum</span></div><form method="get" class="ra-saas-filter-form"><label class="ra-saas-field ra-saas-search"><span>Subject name</span><input name="search" value="@search" placeholder="Search subjects…" /></label><label class="ra-saas-field"><span>Standard</span><select name="standard"><option value="">All standards</option>@foreach(var item in Enum.GetValues<ReliableAcademy.Models.StudentStandard>()){<option value="@item" selected="@(standard==item)">@((int)item)th standard</option>}</select></label><label class="ra-saas-check"><input type="checkbox" name="includeInactive" value="true" checked="@includeInactive"/><span>Include archived</span></label><button class="ra-saas-secondary" type="submit">Apply filters</button><a class="ra-saas-reset" asp-action="Subjects">Reset</a></form></section>
@if(User.IsInRole("Admin")){<section class="ra-saas-panel ra-saas-create-panel" id="add-subject"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">ADD TO CURRICULUM</span><h2>Create a subject</h2><p>Add a clear academic building block for your students.</p></div><span class="ra-saas-feature-icon">＋</span></div><form asp-action="CreateSubject" method="post" class="ra-saas-create-form"><label class="ra-saas-field"><span>Subject name</span><input name="name" maxlength="100" required placeholder="e.g. Mathematics"/></label><label class="ra-saas-field"><span>Standard</span><select name="standard" required>@foreach(var item in Enum.GetValues<ReliableAcademy.Models.StudentStandard>()){<option value="@item">@((int)item)th standard</option>}</select></label><button class="ra-saas-primary" type="submit">Create subject ↗</button></form></section>}
<section class="ra-saas-panel ra-saas-directory"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">YOUR CURRICULUM</span><h2>All subjects</h2></div><span class="ra-saas-panel-caption">@Model.Count entries</span></div><div class="ra-saas-table-wrap"><table class="ra-saas-table"><thead><tr><th>SUBJECT</th><th>STANDARD</th><th>STATUS</th>@if(User.IsInRole("Admin")){<th class="ra-saas-align-right">ACTIONS</th>}</tr></thead><tbody>@foreach(var item in Model){<tr><td><div class="ra-saas-name-cell"><span class="ra-saas-subject-icon">∑</span><div><b>@item.Name</b><small>Academic subject</small></div></div></td><td><span class="ra-saas-standard">@((int)item.Standard)th</span></td><td><span class="ra-saas-status @(item.IsActive?"is-active":"is-inactive")"><i></i>@(item.IsActive?"Active":"Archived")</span></td>@if(User.IsInRole("Admin")){<td class="ra-saas-align-right"><form asp-action="ToggleSubject" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="ra-saas-row-action" type="submit">@(item.IsActive?"Archive":"Restore") ↗</button></form></td>}</tr>}@if(Model.Count==0){<tr><td colspan="4"><div class="ra-saas-empty"><span>∑</span><b>No subjects found</b><p>Try changing filters or create a subject.</p></div></td></tr>}</tbody></table></div></section></div>