@model IReadOnlyList<ReliableAcademy.Models.Announcement>
@{ViewData["Title"]="Announcements";}
<div class="ra-saas-page"><div class="ra-saas-breadcrumb">INSTITUTE <span>/</span> COMMUNICATION</div><div class="ra-saas-page-head"><div><div class="ra-saas-kicker">COMMUNITY UPDATES</div><h1>Announcements <span class="ra-count-chip">@Model.Count total</span></h1><p>Publish clear, timely messages for your institute community.</p></div></div>
@if(TempData["Success"] is string success){<div class="ra-alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="ra-alert-error">@error</div>}
@if(User.IsInRole("Admin")){<section class="ra-saas-panel ra-saas-create-panel"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">CREATE A BROADCAST</span><h2>Publish an announcement</h2><p>Write an update and choose its audience.</p></div><span class="ra-saas-feature-icon">↗</span></div><form asp-action="CreateAnnouncement" method="post"><div class="ra-saas-form-grid ra-saas-announcement-grid"><label class="ra-saas-field"><span>Announcement title</span><input name="title" maxlength="160" required placeholder="Give your update a clear title"/></label><label class="ra-saas-field"><span>Audience</span><select name="audience"><option value="0">Everyone</option><option value="1">Teachers</option><option value="2">Students</option></select></label><label class="ra-saas-field ra-saas-field-full"><span>Message</span><textarea name="message" rows="4" maxlength="3000" required placeholder="Share the details people need to know…"></textarea></label><label class="ra-saas-field"><span>Expiry <small>Optional</small></span><input type="datetime-local" name="expiresAtUtc"/><small>Leave blank for no expiry. Entered time is interpreted as UTC.</small></label></div><div class="ra-saas-form-footer"><span>Keep your message specific and easy to understand.</span><button class="ra-saas-primary" type="submit">Publish announcement ↗</button></div></form></section>}
<section class="ra-saas-panel ra-saas-directory"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">INSTITUTE BULLETIN</span><h2>Recent announcements</h2></div><span class="ra-saas-panel-caption">@Model.Count updates</span></div><div class="ra-saas-announcement-list">@foreach(var item in Model){<article class="ra-saas-broadcast"><div class="ra-saas-broadcast-icon">✳</div><div class="ra-saas-broadcast-body"><div class="ra-saas-broadcast-meta"><span class="ra-saas-audience">@item.Audience</span><span class="ra-saas-status @(item.IsPublished?"is-active":"is-inactive")"><i></i>@(item.IsPublished?"Published":"Unpublished")</span></div><h3>@item.Title</h3><p>@item.Message</p><small>Published @item.PublishedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")@(item.ExpiresAtUtc.HasValue?" · Expires "+item.ExpiresAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy"):"")</small></div>@if(User.IsInRole("Admin")){<form asp-action="ToggleAnnouncement" method="post" class="ra-saas-broadcast-action"><input type="hidden" name="id" value="@item.Id"/><button class="ra-saas-secondary" type="submit">@(item.IsPublished?"Unpublish":"Publish")</button></form>}</article>}@if(Model.Count==0){<div class="ra-saas-empty"><span>✳</span><b>No announcements yet</b><p>Institute updates will appear here.</p></div>}</div></section></div>