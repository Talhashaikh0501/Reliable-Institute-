@model IReadOnlyList<Announcement>
@{
    ViewData["Title"] = "Announcements";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ra-page-heading"><div><div class="ra-eyebrow">INSTITUTE <span>•</span> UPDATES</div><h1>Announcements</h1><p>Published updates shared with all members or specifically with teachers.</p></div></div>
<section class="ra-panel">
    <div class="ra-panel-heading"><div><span>INSTITUTE UPDATES</span><h3>Latest announcements</h3></div><span class="ra-panel-note">@Model.Count update(s)</span></div>
    @if (Model.Count == 0) { <div class="ra-empty"><span>✦</span><b>No announcements yet</b><p>New published updates will appear here.</p></div> }
    else { @foreach (var item in Model) { <article class="ra-announcement"><b>@item.Title</b><p>@item.Message</p><small>@item.PublishedAtUtc.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt")</small></article> } }
</section>
