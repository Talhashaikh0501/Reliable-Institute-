@model StudentDashboardViewModel
@{
    ViewData["Title"] = "My learning";
    var student = Model.Student;
    var firstName = student.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? student.FullName;
}
<div class="ra-student-welcome">
    <div><div class="ra-eyebrow">STUDENT PORTAL <span>•</span> @((int)student.Standard)TH STANDARD</div>
        <h1>Welcome, @firstName!</h1>
        <p>Here is your learning overview. Choose a section below or use the sidebar to open its own page.</p>
    </div>
    <div class="ra-student-identity"><span class="ra-student-avatar">@student.FullName.Trim().Substring(0, 1).ToUpperInvariant()</span>
        <span><b>@student.FullName</b><small>@student.AdmissionNumber · @(student.Batch?.Name ?? "Batch not assigned")</small></span>
    </div>
</div>
@if (TempData["Success"] is string success) { <div class="ra-alert-success" role="status">@success</div> }
<div class="ra-student-stat-grid">
    <article class="ra-panel ra-student-stat"><span>OVERALL ATTENDANCE</span><strong>@Model.AttendanceRate%</strong><small>@Model.PresentCount present/late out of @Model.AttendanceCount records</small></article>
    <article class="ra-panel ra-student-stat"><span>EXAM RESULTS</span><strong>@Model.AllExamCount</strong><small>Recorded examination results</small></article>
    <article class="ra-panel ra-student-stat"><span>FEE BALANCE</span><strong>₹@Model.TotalFeeBalance.ToString("N2")</strong><small>Across all fee plans</small></article>
    <article class="ra-panel ra-student-stat"><span>PAYMENTS</span><strong>₹@Model.TotalFeePaid.ToString("N2")</strong><small>@Model.PaymentHistory.Count transactions recorded</small></article>
</div>
<div class="ra-student-page-links">
    <a class="ra-panel ra-student-page-link" asp-action="Profile"><span>◉</span><div><b>My profile</b><small>Admission and batch details</small></div><strong>↗</strong></a>
    <a class="ra-panel ra-student-page-link" asp-action="Attendance"><span>✓</span><div><b>Attendance</b><small>Full history and month filter</small></div><strong>↗</strong></a>
    <a class="ra-panel ra-student-page-link" asp-action="Results"><span>◎</span><div><b>Exam results</b><small>Marks and subject performance</small></div><strong>↗</strong></a>
    <a class="ra-panel ra-student-page-link" asp-action="Fees"><span>₹</span><div><b>Fee details</b><small>Fee plans and outstanding amounts</small></div><strong>↗</strong></a>
    <a class="ra-panel ra-student-page-link" asp-action="Payments"><span>▤</span><div><b>Payments &amp; receipts</b><small>Transactions and printable receipts</small></div><strong>↗</strong></a>
    <a class="ra-panel ra-student-page-link" asp-action="Announcements"><span>✦</span><div><b>Announcements</b><small>Institute and batch notices</small></div><strong>↗</strong></a>
</div>
<style>
.ra-student-page-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:1rem;margin-top:1.2rem}
.ra-student-page-link{display:flex;align-items:center;gap:1rem;padding:1.25rem;text-decoration:none;color:inherit;transition:transform .2s ease,box-shadow .2s ease}
.ra-student-page-link:hover{transform:translateY(-3px);color:inherit;box-shadow:0 12px 28px rgba(27,62,45,.1)}
.ra-student-page-link>span{width:44px;height:44px;border-radius:12px;background:#e8f0e7;color:#416b50;display:grid;place-items:center;font-weight:750;font-size:1.25rem;flex-shrink:0}
.ra-student-page-link>div{display:grid;gap:.2rem;flex:1;min-width:0}
.ra-student-page-link small{color:#67776d;font-size:.84rem}
.ra-student-page-link>strong{color:#67816d}
</style>
