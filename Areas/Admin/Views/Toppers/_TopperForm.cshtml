@model ReliableAcademy.ViewModels.TopperFormViewModel
@using ReliableAcademy.Models
@{
    var actionName = ViewData["FormAction"]?.ToString() ?? "Create";
}
<section class="ra-panel" style="max-width:900px;padding:26px">
    <form asp-action="@actionName" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="ra-alert-error" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-7"><label asp-for="StudentName" class="form-label"></label><input asp-for="StudentName" class="form-control" /><span asp-validation-for="StudentName" class="text-danger"></span></div>
            <div class="col-md-5"><label asp-for="Standard" class="form-label"></label><select asp-for="Standard" class="form-select"><option value="8">8th Standard</option><option value="9">9th Standard</option><option value="10">10th Standard</option><option value="11">11th Standard</option><option value="12">12th Standard</option></select><span asp-validation-for="Standard" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="AcademicYear" class="form-label"></label><input asp-for="AcademicYear" class="form-control" placeholder="2026-27" /><span asp-validation-for="AcademicYear" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ExamName" class="form-label"></label><input asp-for="ExamName" class="form-control" placeholder="SSC Board Examination" /><span asp-validation-for="ExamName" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="MarksObtained" class="form-label"></label><input asp-for="MarksObtained" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="MarksObtained" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="AchievementNote" class="form-label"></label><input asp-for="AchievementNote" class="form-control" maxlength="240" placeholder="e.g. Scored 100/100 in Mathematics" /><div class="form-text">Optional highlight shown on the homepage, such as a perfect subject score.</div><span asp-validation-for="AchievementNote" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="MaximumMarks" class="form-label"></label><input asp-for="MaximumMarks" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="MaximumMarks" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control" type="number" min="0" /><span asp-validation-for="DisplayOrder" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Photo" class="form-label"></label><input asp-for="Photo" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /><div class="form-text">JPG, PNG or WebP · Maximum 5 MB. @(Model.ExistingPhotoPath is null ? "A photograph is required." : "Leave empty to keep the current photograph.")</div><span asp-validation-for="Photo" class="text-danger"></span></div>
            @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoPath))
            {
                <div class="col-12"><div class="form-text mb-2">Current photograph</div><img src="@Url.Content("~/" + Model.ExistingPhotoPath.TrimStart('/'))" alt="Current topper photograph" style="width:110px;height:130px;object-fit:contain;background:#f1f0ec;border-radius:10px" /></div>
            }
            <div class="col-12"><div class="form-check"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div></div>
            <div class="col-12"><div class="form-check"><input asp-for="HasPublicationConsent" class="form-check-input" /><label asp-for="HasPublicationConsent" class="form-check-label"></label><span asp-validation-for="HasPublicationConsent" class="text-danger d-block"></span></div><div class="form-text">A record is shown publicly only when it is marked visible and this permission is confirmed.</div></div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="ra-primary-button">Save topper</button><a asp-action="Index" class="ra-secondary-button">Cancel</a></div>
    </form>
</section>
