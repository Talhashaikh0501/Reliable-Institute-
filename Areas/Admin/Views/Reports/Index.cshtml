@model ReliableAcademy.Areas.Admin.Controllers.ReportsViewModel
@{ViewData["Title"]="Reports";}
<div class="ra-saas-page ra-saas-reports"><div class="ra-saas-breadcrumb">ANALYTICS <span>/</span> INSTITUTE REPORTS</div><div class="ra-saas-page-head"><div><div class="ra-saas-kicker">PERFORMANCE &amp; FINANCE</div><h1>Reports &amp; insights</h1><p>Understand attendance trends and fee collection for a selected period.</p></div>@if(User.IsInRole("Admin")){<a class="ra-saas-secondary" asp-action="ExportFees" asp-route-from="@Model.From" asp-route-to="@Model.To">⇩ Export fee CSV</a>}</div>
<section class="ra-saas-panel ra-saas-report-filter"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">REPORTING PERIOD</span><h2>Choose your date range</h2></div><span class="ra-saas-feature-icon">▦</span></div><form method="get" class="ra-saas-filter-form"><label class="ra-saas-field"><span>From date</span><input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/></label><label class="ra-saas-field"><span>To date</span><input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/></label><button class="ra-saas-primary" type="submit">Generate report ↗</button></form></section>
<div class="ra-saas-section-head"><div><span class="ra-saas-overline">ATTENDANCE OVERVIEW</span><h2>@Model.From.ToString("dd MMM yyyy") <span>—</span> @Model.To.ToString("dd MMM yyyy")</h2></div><span class="ra-saas-panel-caption">@Model.DailyAttendance.Count recorded days</span></div>
<section class="ra-saas-stat-grid"><article class="ra-saas-stat"><div class="ra-saas-stat-head"><span class="ra-saas-stat-icon stat-green">✓</span><span>PRESENT</span></div><strong>@Model.AttendanceCount(ReliableAcademy.Models.AttendanceStatus.Present)</strong><small>Attendance entries</small></article><article class="ra-saas-stat"><div class="ra-saas-stat-head"><span class="ra-saas-stat-icon stat-amber">!</span><span>ABSENT</span></div><strong>@Model.AttendanceCount(ReliableAcademy.Models.AttendanceStatus.Absent)</strong><small>Attendance entries</small></article><article class="ra-saas-stat"><div class="ra-saas-stat-head"><span class="ra-saas-stat-icon stat-violet">◷</span><span>LATE</span></div><strong>@Model.AttendanceCount(ReliableAcademy.Models.AttendanceStatus.Late)</strong><small>Attendance entries</small></article><article class="ra-saas-stat"><div class="ra-saas-stat-head"><span class="ra-saas-stat-icon stat-blue">↗</span><span>LEAVE</span></div><strong>@Model.AttendanceCount(ReliableAcademy.Models.AttendanceStatus.Leave)</strong><small>Attendance entries</small></article></section>
<section class="ra-saas-panel ra-saas-directory ra-saas-report-table"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">DAY-BY-DAY</span><h2>Attendance breakdown</h2></div><span class="ra-saas-panel-caption">@Model.DailyAttendance.Count days</span></div><div class="ra-saas-table-wrap"><table class="ra-saas-table"><thead><tr><th>DATE</th><th>TOTAL</th><th>PRESENT</th><th>ABSENT</th><th>LATE</th><th>LEAVE</th></tr></thead><tbody>@foreach(var day in Model.DailyAttendance){<tr><td><b>@day.Date.ToString("dd MMM yyyy")</b></td><td>@day.Total</td><td class="ra-saas-number-green">@day.Present</td><td class="ra-saas-number-red">@day.Absent</td><td>@day.Late</td><td>@day.Leave</td></tr>}@if(Model.DailyAttendance.Count==0){<tr><td colspan="6"><div class="ra-saas-empty"><span>▦</span><b>No attendance records</b><p>No attendance data found for this period.</p></div></td></tr>}</tbody></table></div></section>
@if(User.IsInRole("Admin")){<div class="ra-saas-section-head"><div><span class="ra-saas-overline">FINANCIAL OVERVIEW</span><h2>Fee collection</h2></div></div><section class="ra-saas-stat-grid ra-saas-finance-grid"><article class="ra-saas-stat ra-saas-stat-featured"><div class="ra-saas-stat-head"><span class="ra-saas-stat-icon stat-amber">₹</span><span>COLLECTED</span></div><strong>₹@Model.FeesCollected.ToString("N2")</strong><small>Within selected period</small></article><article class="ra-saas-stat"><div class="ra-saas-stat-head"><span class="ra-saas-stat-icon stat-blue">▤</span><span>PAYMENTS</span></div><strong>@Model.PaymentCount</strong><small>Successful payment records</small></article></section><div class="ra-saas-report-grid"><section class="ra-saas-panel ra-saas-directory"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">COLLECTION MIX</span><h2>By payment method</h2></div></div><div class="ra-saas-table-wrap"><table class="ra-saas-table"><thead><tr><th>METHOD</th><th>PAYMENTS</th><th>AMOUNT</th></tr></thead><tbody>@foreach(var item in Model.PaymentMethods){<tr><td><b>@item.Method</b></td><td>@item.Count</td><td>₹@item.Amount.ToString("N2")</td></tr>}@if(Model.PaymentMethods.Count==0){<tr><td colspan="3"><div class="ra-saas-empty">No payments in this period.</div></td></tr>}</tbody></table></div></section><section class="ra-saas-panel ra-saas-directory"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">FOLLOW-UP REQUIRED</span><h2>Outstanding balances</h2></div><span class="ra-saas-panel-caption">Top 25</span></div><div class="ra-saas-table-wrap"><table class="ra-saas-table"><thead><tr><th>STUDENT</th><th>DUE DATE</th><th>BALANCE</th></tr></thead><tbody>@foreach(var item in Model.Defaulters){<tr><td><b>@item.StudentName</b><small class="ra-saas-cell-sub">@item.AdmissionNumber</small></td><td>@item.DueDate.ToString("dd MMM yyyy")</td><td class="ra-saas-balance">₹@item.Balance.ToString("N2")</td></tr>}@if(Model.Defaulters.Count==0){<tr><td colspan="3"><div class="ra-saas-empty">No outstanding balances.</div></td></tr>}</tbody></table></div></section></div>}
</div>