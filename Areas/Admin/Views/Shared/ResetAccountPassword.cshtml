@model ReliableAcademy.ViewModels.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Change account password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ra-page-heading">
    <div>
        <div class="ra-eyebrow">ACCOUNT SECURITY <span>•</span> PASSWORD RESET</div>
        <h1>Change password</h1>
        <p>Set a new password for <strong>@ViewBag.AccountLabel</strong>.</p>
    </div>
    <a class="ra-secondary-button" href="@ViewBag.CancelUrl">← Cancel</a>
</div>
<section class="ra-panel" style="max-width:620px;">
    <div class="ra-panel-heading">
        <div><span>NEW CREDENTIALS</span><h3>Choose a secure password</h3></div>
    </div>
    <p class="text-muted">The password must satisfy the institute password policy: at least 8 characters, including uppercase, lowercase and a number.</p>
    <form asp-area="Admin" asp-controller="@ViewBag.Controller" asp-action="@ViewBag.PostAction" asp-route-id="@ViewBag.AccountId" method="post">
        <div asp-validation-summary="ModelOnly" class="ra-alert-error" role="alert"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="ra-primary-button">Save new password</button>
    </form>
</section>
