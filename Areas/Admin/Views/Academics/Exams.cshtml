@model IReadOnlyList<ReliableAcademy.Models.Exam>
@{ViewData["Title"]="Exams & results";}
<div class="ra-saas-page"><div class="ra-saas-breadcrumb">ACADEMICS <span>/</span> ASSESSMENTS</div><div class="ra-saas-page-head"><div><div class="ra-saas-kicker">ASSESSMENT MANAGEMENT</div><h1>Exams &amp; results <span class="ra-count-chip">@Model.Count scheduled</span></h1><p>Plan examinations, monitor schedules and record student performance.</p></div></div>
@if(TempData["Success"] is string success){<div class="ra-alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="ra-alert-error">@error</div>}
@if(User.IsInRole("Admin")){<section class="ra-saas-panel ra-saas-create-panel"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">ASSESSMENT PLANNER</span><h2>Schedule an exam</h2><p>Set assessment details and grading thresholds.</p></div><span class="ra-saas-feature-icon">▤</span></div><form asp-action="CreateExam" method="post"><div class="ra-saas-form-grid"><label class="ra-saas-field"><span>Exam name</span><input name="name" maxlength="120" required placeholder="e.g. Unit Test 1"/></label><label class="ra-saas-field"><span>Subject</span><select name="subjectId" asp-items="ViewBag.Subjects" required><option value="">Select subject</option></select></label><label class="ra-saas-field"><span>Batch <small>Optional</small></span><select name="batchId" asp-items="ViewBag.Batches"><option value="">All batches in this standard</option></select></label><label class="ra-saas-field"><span>Exam date</span><input type="date" name="examDate" required/></label><label class="ra-saas-field"><span>Maximum marks</span><input type="number" name="maximumMarks" min="1" max="1000" step=".01" required placeholder="100"/></label><label class="ra-saas-field"><span>Passing marks</span><input type="number" name="passingMarks" min="0" max="1000" step=".01" required placeholder="35"/></label></div><div class="ra-saas-form-footer"><span>Confirm maximum and passing marks before scheduling.</span><button class="ra-saas-primary" type="submit">Schedule exam ↗</button></div></form></section>}
<section class="ra-saas-panel ra-saas-directory"><div class="ra-saas-panel-title"><div><span class="ra-saas-overline">ASSESSMENT CALENDAR</span><h2>Scheduled examinations</h2></div><span class="ra-saas-panel-caption">@Model.Count records</span></div><div class="ra-saas-table-wrap"><table class="ra-saas-table"><thead><tr><th>EXAM</th><th>SUBJECT &amp; STANDARD</th><th>DATE</th><th>MARKS</th><th>RESULTS</th><th class="ra-saas-align-right">ACTION</th></tr></thead><tbody>@foreach(var exam in Model){<tr><td><div class="ra-saas-name-cell"><span class="ra-saas-exam-icon">▤</span><div><b>@exam.Name</b><small>@(exam.Batch?.Name??"All batches")</small></div></div></td><td><b>@exam.Subject.Name</b><small class="ra-saas-cell-sub">@((int)exam.Subject.Standard)th standard</small></td><td>@exam.ExamDate.ToString("dd MMM yyyy")</td><td><b>@exam.MaximumMarks.ToString("0.##")</b><small class="ra-saas-cell-sub">Pass: @exam.PassingMarks.ToString("0.##")</small></td><td>@exam.Results.Count <small>entered</small></td><td class="ra-saas-align-right"><a class="ra-saas-row-action" asp-action="Results" asp-route-id="@exam.Id">Manage results ↗</a></td></tr>}@if(Model.Count==0){<tr><td colspan="6"><div class="ra-saas-empty"><span>▤</span><b>No exams scheduled yet</b><p>Use the planner to create your first exam.</p></div></td></tr>}</tbody></table></div></section></div>