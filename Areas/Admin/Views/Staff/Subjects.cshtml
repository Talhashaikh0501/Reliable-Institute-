@model ReliableAcademy.ViewModels.TeacherSubjectAssignmentViewModel
@{
    ViewData["Title"] = "Teacher subject assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ra-page-heading">
    <div><div class="ra-eyebrow">PEOPLE <span>•</span> ACADEMIC ACCESS</div><h1>Assign subjects</h1><p>Choose the exact subjects this teacher is authorized to teach and assess.</p></div>
    <a class="ra-secondary-button" asp-action="Index">← Back to teachers</a>
</div>
@if (TempData["Error"] is string error) { <div class="ra-alert-error" role="alert">@error</div> }
<section class="ra-panel">
    <div class="ra-panel-heading"><div><span>TEACHER ACCOUNT</span><h3>@Model.Email</h3></div><span class="ra-panel-note">@Model.Subjects.Count(x => x.IsAssigned) assigned</span></div>
    @if (Model.Subjects.Count == 0)
    {
        <div class="ra-empty"><span>∑</span><b>No eligible subjects</b><p>First assign an active batch to this teacher. Subjects matching the assigned batch standards will appear here.</p></div>
    }
    else
    {
        <form asp-action="SaveSubjects" method="post">
            <input type="hidden" asp-for="UserId" />
            <div class="ra-teacher-assignment-list">
                @foreach (var subject in Model.Subjects)
                {
                    <label class="ra-teacher-assignment-option @(subject.IsActive ? "" : "is-disabled")">
                        <input type="checkbox" name="SubjectIds" value="@subject.Id" checked="@subject.IsAssigned" disabled="@(!subject.IsActive)" />
                        <span><b>@subject.Name</b><small>@((int)subject.Standard)th standard · @(subject.IsActive ? "Active" : "Archived")</small></span>
                        <span class="ra-status-pill @(subject.IsActive ? "is-active" : "is-inactive")">@(subject.IsActive ? "Available" : "Archived")</span>
                    </label>
                }
            </div>
            <div class="ra-form-actions"><a class="ra-secondary-button" asp-action="Index">Cancel</a><button class="ra-primary-button" type="submit">Save subject access <span>→</span></button></div>
        </form>
    }
</section>
