@model ReliableAcademy.ViewModels.StudentFormViewModel
<div class="ra-form-section">
    <div class="ra-form-section-heading"><span>01</span><div><b>Student information</b><small>Basic identity and academic details.</small></div></div>
    <div class="ra-form-grid">
        <div class="ra-field"><label asp-for="FullName"></label><input asp-for="FullName" placeholder="Enter student's full name" /><span asp-validation-for="FullName"></span></div>
        <div class="ra-field"><label asp-for="AdmissionNumber"></label><input asp-for="AdmissionNumber" placeholder="e.g. RIC-2026-001" /><span asp-validation-for="AdmissionNumber"></span></div>
        <div class="ra-field"><label asp-for="Standard"></label><select asp-for="Standard"><option value="8">8th Standard</option><option value="9">9th Standard</option><option value="10">10th Standard</option><option value="11">11th Standard</option><option value="12">12th Standard</option></select><span asp-validation-for="Standard"></span></div>
        <div class="ra-field"><label asp-for="AcademicYear"></label><input asp-for="AcademicYear" placeholder="2026-2027" /><span asp-validation-for="AcademicYear"></span></div>
        <div class="ra-field"><label asp-for="Division"></label><input asp-for="Division" placeholder="e.g. A" /><span asp-validation-for="Division"></span></div>
        <div class="ra-field"><label asp-for="BatchId"></label><select asp-for="BatchId" asp-items="ViewBag.Batches"><option value="">No batch assigned</option></select><span asp-validation-for="BatchId"></span><small>Batches are filtered by the selected standard.</small></div>
        <div class="ra-field"><label asp-for="AdmissionDate"></label><input asp-for="AdmissionDate" type="date" /><span asp-validation-for="AdmissionDate"></span></div>
        <div class="ra-field"><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date" /><span asp-validation-for="DateOfBirth"></span></div>
    </div>
</div>
<div class="ra-form-section">
    <div class="ra-form-section-heading"><span>02</span><div><b>Contact information</b><small>Student and parent / guardian contact details.</small></div></div>
    <div class="ra-form-grid">
        <div class="ra-field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" placeholder="Student mobile number" /><span asp-validation-for="PhoneNumber"></span></div>
        <div class="ra-field"><label asp-for="Email"></label><input asp-for="Email" placeholder="student@example.com" /><span asp-validation-for="Email"></span></div>
        <div class="ra-field"><label asp-for="GuardianName"></label><input asp-for="GuardianName" placeholder="Parent / guardian full name" /><span asp-validation-for="GuardianName"></span></div>
        <div class="ra-field"><label asp-for="GuardianPhone"></label><input asp-for="GuardianPhone" placeholder="Parent / guardian mobile number" /><span asp-validation-for="GuardianPhone"></span></div>
        <div class="ra-field ra-field-wide"><label asp-for="Address"></label><textarea asp-for="Address" rows="3" placeholder="Residential address"></textarea><span asp-validation-for="Address"></span></div>
    </div>
</div>
