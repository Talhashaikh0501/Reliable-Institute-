@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teaching desk";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ra-dashboard ra-teacher-dashboard">
    <div class="ra-page-heading">
        <div>
            <div class="ra-eyebrow">TEACHER WORKSPACE <span>•</span> RELIABLE ACADEMY</div>
            <h1>Good day, @User.Identity?.Name?.Split('@')[0] 👋</h1>
            <p>Your assigned classes, attendance and academic work — organised in one place.</p>
        </div>
        <div class="ra-date"><span class="ra-live-dot"></span> @Model.Today.ToString("dddd, dd MMMM yyyy")</div>
    </div>

    <section class="ra-welcome ra-teacher-welcome">
        <div>
            <span class="ra-welcome-label">YOUR TEACHING DESK</span>
            <h2>Make every class count.</h2>
            <p>Manage only the batches assigned to you, take attendance and keep student results up to date.</p>
            <div class="ra-teacher-hero-actions">
                <a class="ra-primary-button" asp-area="Teacher" asp-controller="Attendance" asp-action="Index">Take attendance <span>→</span></a>
                <a class="ra-secondary-button" asp-area="Teacher" asp-controller="Students" asp-action="Index">View my students</a>
            </div>
        </div>
        <div class="ra-welcome-mark" aria-hidden="true">✦</div>
    </section>

    @if (Model.ActiveBatches == 0)
    {
        <section class="ra-panel ra-empty ra-teacher-no-assignments">
            <span>▦</span>
            <b>No batches assigned yet</b>
            <p>Your dashboard will show students, attendance and exams after an administrator assigns one or more batches to your teacher account.</p>
        </section>
    }
    else
    {
        <div class="ra-section-heading"><div><span>YOUR DAY AT A GLANCE</span><h3>Teaching overview</h3></div></div>
        <section class="ra-stat-grid">
            <article class="ra-stat-card"><div class="ra-stat-top"><span class="ra-stat-icon ra-icon-blue">♙</span><span class="ra-stat-caption">MY STUDENTS</span></div><strong>@Model.ActiveStudents.ToString("N0")</strong><span class="ra-stat-foot">Active students in your batches</span></article>
            <article class="ra-stat-card"><div class="ra-stat-top"><span class="ra-stat-icon ra-icon-violet">▦</span><span class="ra-stat-caption">MY BATCHES</span></div><strong>@Model.ActiveBatches.ToString("N0")</strong><span class="ra-stat-foot">Assigned active batches</span></article>
            <article class="ra-stat-card"><div class="ra-stat-top"><span class="ra-stat-icon ra-icon-green">✓</span><span class="ra-stat-caption">PRESENT TODAY</span></div><strong>@Model.PresentToday.ToString("N0")</strong><span class="ra-stat-foot">Students marked present</span></article>
            <article class="ra-stat-card"><div class="ra-stat-top"><span class="ra-stat-icon ra-icon-amber">◷</span><span class="ra-stat-caption">ATTENDANCE DONE</span></div><strong>@Model.AttendanceCompletion%</strong><span class="ra-stat-foot">@Model.AttendanceMarkedToday of @Model.ActiveStudents records submitted</span></article>
        </section>

        <div class="ra-content-grid ra-teacher-main-grid">
            <section class="ra-panel">
                <div class="ra-panel-heading"><div><span>YOUR CLASSROOMS</span><h3>Assigned batches</h3></div><span class="ra-panel-note">@Model.Batches.Count batch(es)</span></div>
                <div class="ra-teacher-batch-list">
                    @foreach (var batch in Model.Batches)
                    {
                        <article class="ra-teacher-batch-card">
                            <div class="ra-teacher-batch-mark">@((int)batch.Standard)</div>
                            <div class="ra-teacher-batch-copy">
                                <b>@batch.Name</b>
                                <small>@((int)batch.Standard)th standard · @batch.AcademicYear</small>
                                <small>@(batch.StartTime?.ToString("hh:mm tt") ?? "Time not set") – @(batch.EndTime?.ToString("hh:mm tt") ?? "Time not set") · @batch.StudentCount students</small>
                                <div class="ra-teacher-batch-progress"><span style="width:@(batch.StudentCount == 0 ? 0 : Math.Min(100, 100 * batch.AttendanceMarkedToday / batch.StudentCount))%"></span></div>
                                <small>@batch.AttendanceMarkedToday / @batch.StudentCount attendance marked today</small>
                            </div>
                            <a class="ra-row-action" asp-area="Teacher" asp-controller="Attendance" asp-action="Index" asp-route-batchId="@batch.Id">Register ↗</a>
                        </article>
                    }
                </div>
            </section>

            <section class="ra-panel">
                <div class="ra-panel-heading"><div><span>ACADEMIC CALENDAR</span><h3>Upcoming exams</h3></div><a class="ra-row-action" asp-area="Teacher" asp-controller="Academics" asp-action="Exams">View all ↗</a></div>
                @if (Model.UpcomingExams.Count == 0)
                {
                    <div class="ra-empty"><span>▧</span><b>No upcoming exams</b><p>Assessments for your assigned batches will appear here.</p></div>
                }
                else
                {
                    @foreach (var exam in Model.UpcomingExams)
                    {
                        <article class="ra-announcement ra-teacher-exam-item">
                            <div><b>@exam.Name</b><p>@exam.SubjectName · @exam.BatchName</p><small>@exam.ExamDate.ToString("dd MMM yyyy") · @exam.MaximumMarks.ToString("0.##") marks · @exam.ResultsEntered results entered</small></div>
                            <a class="ra-row-action" asp-area="Teacher" asp-controller="Academics" asp-action="Results" asp-route-id="@exam.Id" asp-route-batchId="@exam.BatchId">Enter marks ↗</a>
                        </article>
                    }
                }
            </section>
        </div>

        <div class="ra-content-grid ra-teacher-lower-grid">
            <section class="ra-panel">
                <div class="ra-panel-heading"><div><span>LAST 14 DAYS</span><h3>Attendance trend</h3></div><span class="ra-panel-note">Present / marked</span></div>
                <div class="ra-teacher-trend">
                    @foreach (var point in Model.AttendanceTrend)
                    {
                        <div class="ra-teacher-trend-day" title="@point.Date.ToString("dd MMM"): @point.Present present from @point.Marked marked">
                            <div class="ra-teacher-trend-bar"><span style="height:@point.Percentage%"></span></div>
                            <small>@point.Date.ToString("dd")</small>
                        </div>
                    }
                </div>
                <div class="ra-teacher-trend-legend"><span><i></i> Present rate among marked students</span><span>Today: @Model.PresentToday present · @Model.AbsentToday absent</span></div>
            </section>

            <section class="ra-panel">
                <div class="ra-panel-heading"><div><span>INSTITUTE UPDATES</span><h3>Announcements</h3></div><a class="ra-row-action" asp-area="Teacher" asp-controller="Academics" asp-action="Announcements">View all ↗</a></div>
                @if (Model.Announcements.Count == 0)
                {
                    <div class="ra-empty"><span>✦</span><b>You're all caught up</b><p>Published teacher announcements will appear here.</p></div>
                }
                else
                {
                    @foreach (var item in Model.Announcements)
                    {
                        <article class="ra-announcement"><b>@item.Title</b><p>@item.Message</p><small>@item.PublishedAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</small></article>
                    }
                }
            </section>
        </div>
    }
    <div class="ra-footer-note"><span>RELIABLE</span> TEACHER WORKSPACE <i>•</i> Focus on teaching</div>
</div>
