@model ReliableAcademy.ViewModels.FeePlanFormViewModel
@{
    ViewData["Title"] = "Create fee plan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ra-page-heading"><div><div class="ra-eyebrow">FINANCE <span>•</span> FEE SETUP</div><h1>Create fee plan</h1><p>Assign the total fee and any approved concession to a student.</p></div><a class="ra-secondary-button" asp-action="Index">← Back to fees</a></div>
<form asp-action="Create" method="post" class="ra-panel ra-form-panel">
    <div asp-validation-summary="ModelOnly" class="ra-validation-summary"></div>
    <div class="ra-form-section"><div class="ra-form-section-heading"><span>01</span><div><b>Student and academic year</b><small>Select the student and the year this fee covers.</small></div></div>
        <div class="ra-form-grid">
            <div class="ra-field ra-field-wide"><label asp-for="StudentId"></label><select asp-for="StudentId" asp-items="ViewBag.Students"><option value="">Choose a student</option></select><span asp-validation-for="StudentId"></span></div>
            <div class="ra-field"><label asp-for="AcademicYear"></label><input asp-for="AcademicYear" placeholder="2026-2027" /><span asp-validation-for="AcademicYear"></span></div>
            <div class="ra-field"><label asp-for="DueDate"></label><input asp-for="DueDate" type="date" /><span asp-validation-for="DueDate"></span></div>
        </div>
    </div>
    <div class="ra-form-section"><div class="ra-form-section-heading"><span>02</span><div><b>Fee structure</b><small>Set the total fee and optional discount or concession.</small></div></div>
        <div class="ra-form-grid">
            <div class="ra-field"><label asp-for="TotalAmount"></label><div class="ra-currency-input"><span>₹</span><input asp-for="TotalAmount" type="number" min="0.01" step="0.01" placeholder="0.00" /></div><span asp-validation-for="TotalAmount"></span></div>
            <div class="ra-field"><label asp-for="DiscountAmount"></label><div class="ra-currency-input"><span>₹</span><input asp-for="DiscountAmount" type="number" min="0" step="0.01" placeholder="0.00" /></div><span asp-validation-for="DiscountAmount"></span></div>
            <div class="ra-field ra-field-wide"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="3" placeholder="Optional notes about the fee plan or approved concession"></textarea><span asp-validation-for="Notes"></span></div>
        </div>
    </div>
    <div class="ra-form-actions"><a class="ra-secondary-button" asp-action="Index">Cancel</a><button class="ra-primary-button" type="submit">Create fee plan →</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
